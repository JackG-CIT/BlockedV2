# Copy this file to .env and fill it in. .env is never committed.

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Leave this blank to use a local SQLite file (blocked.db). That's all you
# need for building levels on your own computer.
# To share one database between computers or host the game online, paste a
# Postgres connection string here, e.g. from https://neon.tech (free):
# DATABASE_URL=postgresql://user:password@ep-something.neon.tech/neondb?sslmode=require
DATABASE_URL=
